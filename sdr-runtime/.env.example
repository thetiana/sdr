API_BIND=0.0.0.0
API_PORT=8081
AUTH_TOKEN=sdr-dev-token
CORS_ORIGINS=http://localhost:3001
METRICS_ENABLED=true
LOG_LEVEL=INFO
SDR_SERIAL=
SDR_DRIVER=rtl-sdr
INITIAL_CENTER_FREQUENCY_HZ=162400000
INITIAL_SAMPLE_RATE_HZ=2400000
INITIAL_BANDWIDTH_HZ=2000000
INITIAL_GAIN_MODE=manual
INITIAL_GAIN_DB=25
INITIAL_PPM=0
INITIAL_ANTENNA=RX
INITIAL_BIAS_TEE=false
SDR_FALLBACK_TO_MOCK_ON_ERROR=true
STRICT_CAPABILITY_CHECK=true
RETUNE_POLICY=deny
MAX_CHANNELS=32
MAX_SCANNERS=8
MAX_STREAMS=32
EVENT_HISTORY_LIMIT=200
PRE_ROLL_MS_DEFAULT=1000
POST_ROLL_MS_DEFAULT=1000
ACTIVITY_AUDIO_TTL_SECONDS=900
